# Where the local content-addressed store lives.
AGENT_MILESTONE_DB=~/.claude/agent-milestone/milestones.db

# Redact API keys/tokens/passwords before writing (default: 1).
AGENT_MILESTONE_REDACT=1

# Set to 0 if you do not want SessionEnd to refresh the iCloud HTML viewer.
AGENT_MILESTONE_AUTO_ICLOUD=1
